# Supabase Project Settings > API. Use the project URL, not the website URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://your-site.example

# Server-only scheduler credential, unrelated to device tokens.
CRON_SECRET=
