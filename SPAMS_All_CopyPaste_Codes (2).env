constexpr uint32_t MAGIC = 0x5350414D;  // 'SPAM'
constexpr uint8_t PROTOCOL_VERSION = 1;
constexpr uint32_t UPLOAD_INTERVAL_MS = 30000;
constexpr uint32_t MAX_NODE_AGE_MS = 120000;
constexpr uint8_t VALID_TEMP = 0x01;
constexpr uint8_t VALID_TDS = 0x02;
constexpr uint8_t VALID_PH = 0x04;
constexpr uint8_t VALID_TURBIDITY = 0x08;
constexpr uint8_t VALID_WATER_RAW = 0x10;

struct __attribute__((packed)) SensorPacket {
  uint32_t magic;
  uint8_t version, slot, validMask, reserved;
  uint32_t sequence;
  char bootId[37];
  float temperatureC, tdsPpm, ph, turbidityVoltage;
  uint16_t waterLevelRaw, reserved2;
  uint32_t checksum;
};
struct RxPacket {
  SensorPacket sample;
  uint32_t arrivalMs;
  time_t receivedEpoch;
};
struct NodeCache {
  bool present = false;
  RxPacket rx{};
  bool unpublished = false;
};
QueueHandle_t rxQueue;
NodeCache cache[2];
char gatewayBootId[37];
uint32_t gatewaySeq = 0;
uint32_t previousUpload = 0;
String pendingJson;
uint32_t pendingNodeSeq[2] = {0, 0};
char pendingNodeBoot[2][37] = {{0}, {0}};
bool pendingNodeIncluded[2] = {false, false};

uint32_t checksum32(const SensorPacket &p) {
  const uint8_t *b = reinterpret_cast<const uint8_t *>(&p);
  uint32_t hash = 2166136261u;
  for (size_t i = 0; i < sizeof(p) - sizeof(p.checksum); ++i)
    hash = (hash ^ b[i]) * 16777619u;
  return hash;
}

void makeUuid(char out[37]) {
  uint8_t b[16];
  for (int i = 0; i < 16; i += 4) {
    uint32_t r = esp_random();
    memcpy(b + i, &r, 4);
  }
  b[6] = (b[6] & 0x0F) | 0x40;  // Version 4.
  b[8] = (b[8] & 0x3F) | 0x80;  // RFC variant.
  snprintf(out, 37,
           "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-"
           "%02x%02x%02x%02x%02x%02x",
           b[0],b[1],b[2],b[3],b[4],b[5],b[6],b[7],
           b[8],b[9],b[10],b[11],b[12],b[13],b[14],b[15]);
}

String utcIso(time_t stamp) {
  struct tm t;
  gmtime_r(&stamp, &t);
  char buf[25];
  strftime(buf, sizeof(buf), "%Y-%m-%dT%H:%M:%SZ", &t);
  return String(buf);
}

void onEspNowReceive(const esp_now_recv_info_t *info,
                     const uint8_t *data, int len) {
  if (len != sizeof(SensorPacket) || !data || !info) return;
  RxPacket item{};
  memcpy(&item.sample, data, sizeof(SensorPacket));
  const SensorPacket &p = item.sample;
  if (p.magic != MAGIC || p.version != PROTOCOL_VERSION ||
      p.slot < 1 || p.slot > 2 || p.bootId[36] != '\0' ||
      p.checksum != checksum32(p)) return;
  item.arrivalMs = millis();
  item.receivedEpoch = time(nullptr); // Gateway receive time, NOT node sample time.
  xQueueSend(rxQueue, &item, 0); // No HTTP or Serial inside Wi-Fi callback.
}

void drainReceiveQueue() {
  RxPacket item;
  while (xQueueReceive(rxQueue, &item, 0) == pdTRUE) {
    NodeCache &c = cache[item.sample.slot - 1];
    const bool sameBoot = c.present &&
      strcmp(c.rx.sample.bootId, item.sample.bootId) == 0;
    if (sameBoot && item.sample.sequence <= c.rx.sample.sequence) continue;
    c.rx = item;
    c.present = true;
    c.unpublished = true;
    const SensorPacket &p = item.sample;
    Serial.printf("NODE %u seq=%lu temp=%.2fC TDS=%.1fppm "
                  "pH=%.2f turbidity=%.2fV levelRAW=%u mask=0x%02X\n",
      p.slot, (unsigned long)p.sequence, p.temperatureC,
      p.tdsPpm, p.ph, p.turbidityVoltage,
      p.waterLevelRaw, p.validMask);
  }
}

String buildPacket() {
  time_t now = time(nullptr);
  if (now < 1700000000) return String(); // Wait for valid NTP clock.
  String body;
  body.reserve(1100);
  body += "{\"gateway\":{\"boot_id\":\"";
  body += gatewayBootId;
  body += "\",\"sequence\":";
  body += String(gatewaySeq++);
  body += ",\"sampled_at\":\"";
  body += utcIso(now);
  body += "\",\"battery_percent\":null,\"voltage\":null,";
  body += "\"charging\":null,\"solar_watts\":null,";
  body += "\"solar_voltage\":null,\"pump_state\":\"unknown\"},\"nodes\":[";
  bool first = true;
  for (int i = 0; i < 2; ++i) pendingNodeIncluded[i] = false;
  for (int i = 0; i < 2; ++i) {
    NodeCache &c = cache[i];
    if (!c.present || !c.unpublished ||
        millis() - c.rx.arrivalMs > MAX_NODE_AGE_MS) continue;
    const SensorPacket &p = c.rx.sample;
    pendingNodeIncluded[i] = true;
    pendingNodeSeq[i] = p.sequence;
    memcpy(pendingNodeBoot[i], p.bootId, sizeof(p.bootId));
    if (!first) body += ',';
    first = false;
    body += "{\"node_id\":\"";
    body += (i == 0 ? NODE1_UUID : NODE2_UUID);
    body += "\",\"boot_id\":\"";
    body += p.bootId;
    body += "\",\"sequence\":";
    body += String(p.sequence);
    body += ",\"sampled_at\":\"";
    // ESP-NOW nodes have no synchronized clock. Use gateway receive time.
    time_t when = c.rx.receivedEpoch >= 1700000000 ?
                  c.rx.receivedEpoch : now;
    body += utcIso(when);
    body += "\",\"temperature_c\":";
    if (p.validMask & VALID_TEMP) body += String(p.temperatureC, 2);
    else body += "null";
    body += ",\"water_level_m\":null,\"battery_percent\":null";
    body += ",\"tds_ppm\":";
    if (p.validMask & VALID_TDS) body += String(p.tdsPpm, 2);
    else body += "null";
    body += ",\"ph_value\":";
    if (p.validMask & VALID_PH) body += String(p.ph, 2);
    else body += "null";
    body += ",\"turbidity_voltage\":";
    if (p.validMask & VALID_TURBIDITY)
      body += String(p.turbidityVoltage, 3);
    else body += "null";
    body += ",\"turbidity_ntu\":null,\"water_level_raw\":";
    if (p.validMask & VALID_WATER_RAW) body += String(p.waterLevelRaw);
    else body += "null";
    body += ",\"sensor_health\":\"";
    const bool temperatureValid = p.validMask & VALID_TEMP;
    const bool rawLevelValid = p.validMask & VALID_WATER_RAW;
    body += temperatureValid
                ? (rawLevelValid ? "healthy" : "degraded")
                : "failed";
    body += "\"}";
  }
  body += "]}";
  return body;
}

bool submitPending() {
  if (pendingJson.isEmpty() || WiFi.status() != WL_CONNECTED) return false;
  WiFiClientSecure tls;
  tls.setCACert(HTTPS_ROOTS); // Never use setInsecure().
  HTTPClient http;
  http.setTimeout(12000);
  if (!http.begin(tls, API_URL)) return false;
  http.addHeader("Content-Type", "application/json");
  http.addHeader("Authorization", String("Bearer ") + DEVICE_TOKEN);
  const int status = http.POST(pendingJson);
  const String reply = http.getString();
  http.end();
  Serial.printf("Cloud HTTP %d: %s\n", status, reply.c_str());
  if (status != 200 && status != 201) return false;
  pendingJson = "";
  for (int i = 0; i < 2; ++i) {
    if (pendingNodeIncluded[i] && cache[i].present &&
        cache[i].rx.sample.sequence == pendingNodeSeq[i] &&
        strcmp(cache[i].rx.sample.bootId, pendingNodeBoot[i]) == 0)
      cache[i].unpublished = false;
  }
  return true;
}

void setup() {
  Serial.begin(115200);
  delay(500);
  rxQueue = xQueueCreate(16, sizeof(RxPacket));
  if (!rxQueue) { Serial.println("Queue allocation failed"); abort(); }
  makeUuid(gatewayBootId);
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting to Wi-Fi");
  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print('.'); }
  Serial.println();
  Serial.printf("Gateway MAC: %s, Wi-Fi channel: %d\n",
                WiFi.macAddress().c_str(), WiFi.channel());
  configTime(0, 0, "pool.ntp.org", "time.google.com");
  if (esp_now_init() != ESP_OK) { Serial.println("ESP-NOW failed"); abort(); }
  esp_now_register_recv_cb(onEspNowReceive);
  Serial.println("SPAMS gateway ready. Use router 2.4 GHz channel 1-11.");
}

void loop() {
  drainReceiveQueue();
  if (WiFi.status() != WL_CONNECTED) {
    static uint32_t lastRetry = 0;
    if (millis() - lastRetry > 5000) {
      lastRetry = millis();
      WiFi.reconnect();
    }
  }
  if (millis() - previousUpload < UPLOAD_INTERVAL_MS) {
    delay(25); return;
  }
  previousUpload = millis();
  if (pendingJson.isEmpty()) pendingJson = buildPacket();
  if (!pendingJson.isEmpty() && !submitPending())
    Serial.println("Upload pending; will retry identical packet next interval.");
}
```

## SPAMS_Node_1.ino

```cpp
/* SPAMS Node 1 - original ESP32 DevKit / ESP32-WROOM only.
 * GPIO pin assignments are preserved from uploaded ESP32.docx.
 * ESP-NOW broadcast scans channels 1..11; no router password is needed.
 * The above-water INMP441 is NOT implemented in this sensor test.
 */
#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>
#include <esp_system.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include <math.h>

constexpr uint8_t NODE_SLOT = 1;
constexpr uint8_t DS18B20_PIN = 4;
constexpr uint8_t TDS_PIN = 35;
constexpr uint8_t PH_PIN = 34;
constexpr uint8_t WATER_LEVEL_PIN = 33;
constexpr uint8_t TURBIDITY_PIN = 27; // ADC2: temporarily stop radio to read.
constexpr float PH_DIVIDER_RATIO = 37.0f / 17.0f;
constexpr float TURBIDITY_DIVIDER_RATIO = 67.0f / 20.0f;
constexpr float PH7_OUTPUT_V = 2.50f; // Example: REPLACE after pH7 calibration.
constexpr float PH4_OUTPUT_V = 3.00f; // Example: REPLACE after pH4 calibration.
constexpr bool PH_CALIBRATED = false;  // Set true only after calibration.
constexpr uint32_t MAGIC = 0x5350414D;
constexpr uint8_t PROTOCOL_VERSION = 1;
constexpr uint8_t VALID_TEMP = 0x01;
constexpr uint8_t VALID_TDS = 0x02;
constexpr uint8_t VALID_PH = 0x04;
constexpr uint8_t VALID_TURBIDITY = 0x08;
constexpr uint8_t VALID_WATER_RAW = 0x10;
constexpr uint32_t SAMPLE_EVERY_MS = 30000;

struct __attribute__((packed)) SensorPacket {
  uint32_t magic;
  uint8_t version, slot, validMask, reserved;
  uint32_t sequence;
  char bootId[37];
  float temperatureC, tdsPpm, ph, turbidityVoltage;
  uint16_t waterLevelRaw, reserved2;
  uint32_t checksum;
};
OneWire oneWire(DS18B20_PIN);
DallasTemperature thermometer(&oneWire);
const uint8_t BROADCAST[6] = {0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};
char nodeBootId[37];
uint32_t nextSequence = 0;
uint32_t lastSample = 0;

uint32_t checksum32(const SensorPacket &p) {
  const uint8_t *b = reinterpret_cast<const uint8_t *>(&p);
  uint32_t hash = 2166136261u;
  for (size_t i = 0; i < sizeof(p) - sizeof(p.checksum); ++i)
    hash = (hash ^ b[i]) * 16777619u;
  return hash;
}
void makeUuid(char out[37]) {
  uint8_t b[16];
  for (int i = 0; i < 16; i += 4) {
    uint32_t r = esp_random();
    memcpy(b + i, &r, 4);
  }
  b[6] = (b[6] & 0x0F) | 0x40;
  b[8] = (b[8] & 0x3F) | 0x80;
  snprintf(out, 37,
           "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-"
           "%02x%02x%02x%02x%02x%02x",
           b[0],b[1],b[2],b[3],b[4],b[5],b[6],b[7],
           b[8],b[9],b[10],b[11],b[12],b[13],b[14],b[15]);
}
float averageAdcVoltage(uint8_t pin) {
  uint32_t mv = 0;
  for (int i = 0; i < 30; ++i) {
    mv += analogReadMilliVolts(pin);
    delay(5);
  }
  return (mv / 30.0f) / 1000.0f;
}
void initEspNow() {
  WiFi.mode(WIFI_STA);  // ESP-NOW needs Wi-Fi radio, but no AP connection.
  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW init failed"); return;
  }
  esp_now_peer_info_t peer{};
  memcpy(peer.peer_addr, BROADCAST, 6);
  peer.channel = 0; // Use current channel while scanning.
  peer.encrypt = false; // LAB ONLY. Broadcast is not authenticated.
  if (esp_now_add_peer(&peer) != ESP_OK)
    Serial.println("Broadcast peer failed");
}

// GPIO27 is ESP32 ADC2, inaccessible while Wi-Fi/ESP-NOW is active.
// Stop the radio briefly rather than invent a turbidity measurement.
float readTurbidityWithRadioOff() {
  esp_now_deinit();
  WiFi.mode(WIFI_OFF);
  delay(100);
  analogSetPinAttenuation(TURBIDITY_PIN, ADC_11db);
  const float adcV = averageAdcVoltage(TURBIDITY_PIN);
  initEspNow();
  return adcV;
}

SensorPacket measure() {
  SensorPacket p{};
  p.magic = MAGIC;
  p.version = PROTOCOL_VERSION;
  p.slot = NODE_SLOT;
  p.sequence = nextSequence++;
  memcpy(p.bootId, nodeBootId, sizeof(p.bootId));

  thermometer.requestTemperatures();
  const float t = thermometer.getTempCByIndex(0);
  if (isfinite(t) && t != DEVICE_DISCONNECTED_C && t != 85.0f &&
      t >= -10.0f && t <= 60.0f) {
    p.temperatureC = t;
    p.validMask |= VALID_TEMP;
  }
  const float tempForComp = (p.validMask & VALID_TEMP) ? t : 25.0f;
  const float tdsV = averageAdcVoltage(TDS_PIN);
  const float adjusted = tdsV / (1.0f + 0.02f * (tempForComp - 25.0f));
  const float tds = (133.42f*adjusted*adjusted*adjusted
                    - 255.86f*adjusted*adjusted + 857.39f*adjusted)*0.5f;
  if (isfinite(tds) && tdsV > 0.01f && tds >= 0 && tds <= 10000) {
    p.tdsPpm = tds;
    p.validMask |= VALID_TDS;
  }
  const float phOutput = averageAdcVoltage(PH_PIN) * PH_DIVIDER_RATIO;
  if (PH_CALIBRATED && fabsf(PH4_OUTPUT_V - PH7_OUTPUT_V) > 0.01f) {
    const float ph = 7.0f + (phOutput - PH7_OUTPUT_V) *
                          (4.0f - 7.0f) / (PH4_OUTPUT_V - PH7_OUTPUT_V);
    if (isfinite(ph) && ph >= 0.0f && ph <= 14.0f) {
      p.ph = ph;
      p.validMask |= VALID_PH;
    }
  }
  // RAW LEVEL IS NOT A METERS VALUE. Requires separate calibration.
  const int water = analogRead(WATER_LEVEL_PIN);
  if (water >= 0 && water <= 4095) {
    p.waterLevelRaw = (uint16_t)water;
    p.validMask |= VALID_WATER_RAW;
  }
  const float turbAdcV = readTurbidityWithRadioOff();
  if (isfinite(turbAdcV) && turbAdcV > 0.01f && turbAdcV < 3.25f) {
    p.turbidityVoltage = turbAdcV * TURBIDITY_DIVIDER_RATIO;
    p.validMask |= VALID_TURBIDITY;
  }
  p.checksum = checksum32(p);
  return p;
}

void broadcastReading(const SensorPacket &p) {
  // Demo-only discovery: send the same packet across 2.4 GHz channels 1-11.
  // Router/gateway must use 1-11, and both devices must be ESP32 2.4 GHz.
  for (uint8_t channel = 1; channel <= 11; ++channel) {
    if (esp_wifi_set_channel(channel, WIFI_SECOND_CHAN_NONE) == ESP_OK) {
      esp_now_send(BROADCAST, (const uint8_t *)&p, sizeof(p));
      delay(75); // Permit asynchronous ESPNOW transmission before switching.
    }
  }
  Serial.printf("Node %u broadcast seq=%lu temp=%.2f TDS=%.1f "
                "pH=%.2f turb=%.2fV waterRAW=%u mask=0x%02X\n",
    NODE_SLOT, (unsigned long)p.sequence, p.temperatureC, p.tdsPpm,
    p.ph, p.turbidityVoltage, p.waterLevelRaw, p.validMask);
}

void setup() {
  Serial.begin(115200);
  delay(500);
  makeUuid(nodeBootId);
  thermometer.begin();
  analogReadResolution(12);
  analogSetPinAttenuation(TDS_PIN, ADC_11db);
  analogSetPinAttenuation(PH_PIN, ADC_11db);
  analogSetPinAttenuation(WATER_LEVEL_PIN, ADC_11db);
  analogSetPinAttenuation(TURBIDITY_PIN, ADC_11db);
  initEspNow();
  Serial.printf("SPAMS NODE %u: %d DS18B20 sensor(s)\n",
                NODE_SLOT, thermometer.getDeviceCount());
  Serial.println("pH disabled until calibration; GPIO27 ADC2 radio pause enabled.");
}
void loop() {
  if (lastSample == 0 || millis() - lastSample >= SAMPLE_EVERY_MS) {
    lastSample = millis();
    SensorPacket p = measure();
    broadcastReading(p);
  }
  delay(20);
}
```

## SPAMS_Node_2.ino

```cpp
/* SPAMS Node 2 - original ESP32 DevKit / ESP32-WROOM only.
 * GPIO pin assignments are preserved from uploaded ESP32.docx.
 * ESP-NOW broadcast scans channels 1..11; no router password is needed.
 * The above-water INMP441 is NOT implemented in this sensor test.
 */
#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>
#include <esp_system.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include <math.h>

constexpr uint8_t NODE_SLOT = 2;
constexpr uint8_t DS18B20_PIN = 4;
constexpr uint8_t TDS_PIN = 35;
constexpr uint8_t PH_PIN = 34;
constexpr uint8_t WATER_LEVEL_PIN = 33;
constexpr uint8_t TURBIDITY_PIN = 27; // ADC2: temporarily stop radio to read.
constexpr float PH_DIVIDER_RATIO = 37.0f / 17.0f;
constexpr float TURBIDITY_DIVIDER_RATIO = 67.0f / 20.0f;
constexpr float PH7_OUTPUT_V = 2.50f; // Example: REPLACE after pH7 calibration.
constexpr float PH4_OUTPUT_V = 3.00f; // Example: REPLACE after pH4 calibration.
constexpr bool PH_CALIBRATED = false;  // Set true only after calibration.
constexpr uint32_t MAGIC = 0x5350414D;
constexpr uint8_t PROTOCOL_VERSION = 1;
constexpr uint8_t VALID_TEMP = 0x01;
constexpr uint8_t VALID_TDS = 0x02;
constexpr uint8_t VALID_PH = 0x04;
constexpr uint8_t VALID_TURBIDITY = 0x08;
constexpr uint8_t VALID_WATER_RAW = 0x10;
constexpr uint32_t SAMPLE_EVERY_MS = 30000;

struct __attribute__((packed)) SensorPacket {
  uint32_t magic;
  uint8_t version, slot, validMask, reserved;
  uint32_t sequence;
  char bootId[37];
  float temperatureC, tdsPpm, ph, turbidityVoltage;
  uint16_t waterLevelRaw, reserved2;
  uint32_t checksum;
};
OneWire oneWire(DS18B20_PIN);
DallasTemperature thermometer(&oneWire);
const uint8_t BROADCAST[6] = {0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};
char nodeBootId[37];
uint32_t nextSequence = 0;
uint32_t lastSample = 0;

uint32_t checksum32(const SensorPacket &p) {
  const uint8_t *b = reinterpret_cast<const uint8_t *>(&p);
  uint32_t hash = 2166136261u;
  for (size_t i = 0; i < sizeof(p) - sizeof(p.checksum); ++i)
    hash = (hash ^ b[i]) * 16777619u;
  return hash;
}
void makeUuid(char out[37]) {
  uint8_t b[16];
  for (int i = 0; i < 16; i += 4) {
    uint32_t r = esp_random();
    memcpy(b + i, &r, 4);
  }
  b[6] = (b[6] & 0x0F) | 0x40;
  b[8] = (b[8] & 0x3F) | 0x80;
  snprintf(out, 37,
           "%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-"
           "%02x%02x%02x%02x%02x%02x",
           b[0],b[1],b[2],b[3],b[4],b[5],b[6],b[7],
           b[8],b[9],b[10],b[11],b[12],b[13],b[14],b[15]);
}
float averageAdcVoltage(uint8_t pin) {
  uint32_t mv = 0;
  for (int i = 0; i < 30; ++i) {
    mv += analogReadMilliVolts(pin);
    delay(5);
  }
  return (mv / 30.0f) / 1000.0f;
}
void initEspNow() {
  WiFi.mode(WIFI_STA);  // ESP-NOW needs Wi-Fi radio, but no AP connection.
  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW init failed"); return;
  }
  esp_now_peer_info_t peer{};
  memcpy(peer.peer_addr, BROADCAST, 6);
  peer.channel = 0; // Use current channel while scanning.
  peer.encrypt = false; // LAB ONLY. Broadcast is not authenticated.
  if (esp_now_add_peer(&peer) != ESP_OK)
    Serial.println("Broadcast peer failed");
}

// GPIO27 is ESP32 ADC2, inaccessible while Wi-Fi/ESP-NOW is active.
// Stop the radio briefly rather than invent a turbidity measurement.
float readTurbidityWithRadioOff() {
  esp_now_deinit();
  WiFi.mode(WIFI_OFF);
  delay(100);
  analogSetPinAttenuation(TURBIDITY_PIN, ADC_11db);
  const float adcV = averageAdcVoltage(TURBIDITY_PIN);
  initEspNow();
  return adcV;
}

SensorPacket measure() {
  SensorPacket p{};
  p.magic = MAGIC;
  p.version = PROTOCOL_VERSION;
  p.slot = NODE_SLOT;
  p.sequence = nextSequence++;
  memcpy(p.bootId, nodeBootId, sizeof(p.bootId));

  thermometer.requestTemperatures();
  const float t = thermometer.getTempCByIndex(0);
  if (isfinite(t) && t != DEVICE_DISCONNECTED_C && t != 85.0f &&
      t >= -10.0f && t <= 60.0f) {
    p.temperatureC = t;
    p.validMask |= VALID_TEMP;
  }
  const float tempForComp = (p.validMask & VALID_TEMP) ? t : 25.0f;
  const float tdsV = averageAdcVoltage(TDS_PIN);
  const float adjusted = tdsV / (1.0f + 0.02f * (tempForComp - 25.0f));
  const float tds = (133.42f*adjusted*adjusted*adjusted
                    - 255.86f*adjusted*adjusted + 857.39f*adjusted)*0.5f;
  if (isfinite(tds) && tdsV > 0.01f && tds >= 0 && tds <= 10000) {
    p.tdsPpm = tds;
    p.validMask |= VALID_TDS;
  }
  const float phOutput = averageAdcVoltage(PH_PIN) * PH_DIVIDER_RATIO;
  if (PH_CALIBRATED && fabsf(PH4_OUTPUT_V - PH7_OUTPUT_V) > 0.01f) {
    const float ph = 7.0f + (phOutput - PH7_OUTPUT_V) *
                          (4.0f - 7.0f) / (PH4_OUTPUT_V - PH7_OUTPUT_V);
    if (isfinite(ph) && ph >= 0.0f && ph <= 14.0f) {
      p.ph = ph;
      p.validMask |= VALID_PH;
    }
  }
  // RAW LEVEL IS NOT A METERS VALUE. Requires separate calibration.
  const int water = analogRead(WATER_LEVEL_PIN);
  if (water >= 0 && water <= 4095) {
    p.waterLevelRaw = (uint16_t)water;
    p.validMask |= VALID_WATER_RAW;
  }
  const float turbAdcV = readTurbidityWithRadioOff();
  if (isfinite(turbAdcV) && turbAdcV > 0.01f && turbAdcV < 3.25f) {
    p.turbidityVoltage = turbAdcV * TURBIDITY_DIVIDER_RATIO;
    p.validMask |= VALID_TURBIDITY;
  }
  p.checksum = checksum32(p);
  return p;
}

void broadcastReading(const SensorPacket &p) {
  // Demo-only discovery: send the same packet across 2.4 GHz channels 1-11.
  // Router/gateway must use 1-11, and both devices must be ESP32 2.4 GHz.
  for (uint8_t channel = 1; channel <= 11; ++channel) {
    if (esp_wifi_set_channel(channel, WIFI_SECOND_CHAN_NONE) == ESP_OK) {
      esp_now_send(BROADCAST, (const uint8_t *)&p, sizeof(p));
      delay(75); // Permit asynchronous ESPNOW transmission before switching.
    }
  }
  Serial.printf("Node %u broadcast seq=%lu temp=%.2f TDS=%.1f "
                "pH=%.2f turb=%.2fV waterRAW=%u mask=0x%02X\n",
    NODE_SLOT, (unsigned long)p.sequence, p.temperatureC, p.tdsPpm,
    p.ph, p.turbidityVoltage, p.waterLevelRaw, p.validMask);
}

void setup() {
  Serial.begin(115200);
  delay(500);
  makeUuid(nodeBootId);
  thermometer.begin();
  analogReadResolution(12);
  analogSetPinAttenuation(TDS_PIN, ADC_11db);
  analogSetPinAttenuation(PH_PIN, ADC_11db);
  analogSetPinAttenuation(WATER_LEVEL_PIN, ADC_11db);
  analogSetPinAttenuation(TURBIDITY_PIN, ADC_11db);
  initEspNow();
  Serial.printf("SPAMS NODE %u: %d DS18B20 sensor(s)\n",
                NODE_SLOT, thermometer.getDeviceCount());
  Serial.println("pH disabled until calibration; GPIO27 ADC2 radio pause enabled.");
}
void loop() {
  if (lastSample == 0 || millis() - lastSample >= SAMPLE_EVERY_MS) {
    lastSample = millis();
    SensorPacket p = measure();
    broadcastReading(p);
  }
  delay(20);
}
```


## Setup notes
SPAMS ESP32 code bundle (original files from the prior implementation guide).

1. SPAMS_Central_Gateway.ino:
   Edit WIFI_SSID, WIFI_PASSWORD, DEVICE_TOKEN, NODE1_UUID, NODE2_UUID.
   DEVICE_TOKEN and node UUIDs must match provisioned values in Supabase.

2. SPAMS_Node_1.ino:
   NODE_SLOT = 1; no Wi-Fi password required for ESP-NOW broadcast.

3. SPAMS_Node_2.ino:
   NODE_SLOT = 2; no Wi-Fi password required for ESP-NOW broadcast.

Arduino IDE: install the ESP32 board package (target ESP32 DevKit/WROOM Arduino-ESP32 3.x), and OneWire and DallasTemperature libraries. These sketches have not been compiled/verified on physical hardware; test and calibrate before deployment.

After applying the water-quality migration, the server stores pH, TDS, turbidity voltage, and raw water-level ADC as well as temperature and calibrated water-level meters. The GPIO27 ADC2 turbidity workaround and channel-scanning ESP-NOW broadcast are for lab demonstrations, not fully tested field reliability or secure use.
No INMP441 recording or Random Forest classifier is included in this firmware.
